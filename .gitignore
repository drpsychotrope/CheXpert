node_modules/
dist/
dist-ssr/
*.local
.DS_Store
*.log
npm-debug.log*
.vite/
coverage/
# large engine source package (we vendor only the needed asset into public/)
/scripts/.cache/
# vendored Stockfish asset — regenerated from node_modules by `npm run copy:engine` (postinstall). Keeps the ~7MB wasm out of git.
/public/stockfish/
# ETL output — regenerated from the Lichess CC0 DB by `npm run etl:puzzles`. The seed set is committed; the big subset is not.
/public/puzzles/puzzles.json
/lichess_db_puzzle.csv
_*.txt
# .exe launcher build output — regenerated by `npm run build:exe` (69MB exe + assets)
/build/
# graphify knowledge-graph output — portable artifacts (GRAPH_REPORT.md, graph.json, graph.html) are committed.
# Machine-specific / transient state is regenerated by `/graphify` and stays local.
/graphify-out/.graphify_*
/graphify-out/manifest.json
/graphify-out/cost.json
/src/graphify-out/
